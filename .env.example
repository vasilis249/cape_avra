# Copy to .env.local and fill in. Never commit .env.local.

# Public base URL (used for canonical, hreflang, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override content/site.config.ts mode ("preview" | "live")
# SITE_MODE=preview

# Allow search engines outside Vercel (on Vercel, only the production deployment is indexable)
# ALLOW_INDEXING=false

# --- Early booking / contact forms (Phase 2) ----------------------------
# Without these, local runs store requests in .data/leads.jsonl and print emails
# to the console; on Vercel the forms ask visitors to email instead.
# Supabase project → Settings → API. The service-role key is server-only: never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend → API keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Cape Avra <hello@capeavra.com>"
# Where new requests are sent (defaults to the contact email in content/site.config.ts)
OWNER_NOTIFICATION_EMAIL=

# --- Booking engine (Phase 3) -------------------------------------------
# Supabase → Connect → "Transaction pooler" connection string (port 6543). Server only.
# Without it, local runs store bookings in .data/booking.json; on Vercel booking is unavailable.
DATABASE_URL=
# Secret part of our iCal export URL: https://capeavra.com/api/ical/<token>
# (paste that URL into Airbnb / Booking.com "import calendar"). Long random string.
ICAL_EXPORT_TOKEN=
# Calendars to import, as JSON: {"airbnb":"https://www.airbnb.com/calendar/ical/…","booking":"https://…"}
ICAL_FEEDS=
# Vercel Cron sends this as a Bearer token to /api/cron/*. Long random string.
CRON_SECRET=
# Secret for the guests' "manage booking" links in emails (HMAC). Long random string (32+ chars).
# Required in production; changing it invalidates links already sent.
BOOKING_LINK_SECRET=

# --- Payments (Phase 4) --------------------------------------------------
# "test" simulates payments (local/preview only, never in production); "stripe" uses Stripe.
PAYMENTS_PROVIDER=test
# Stripe → Developers → API keys. Use TEST keys (sk_test_ / pk_test_) everywhere except the
# production deployment; live keys are refused outside production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → endpoint https://<domain>/api/webhooks/stripe → "Signing secret"
# (locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints one)
STRIPE_WEBHOOK_SECRET=

# --- Later phases (not used yet) -----------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
